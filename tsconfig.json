{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node", "@cloudflare/workers-types"],
    "paths": {
      "@stack": ["./alchemy.run.ts"],
      "@api/*": ["./apps/api/src/api/*"],
      "@server/*": ["./apps/api/src/server/*"],
      "@platform/*": ["./apps/api/src/platform/*"],
      "@infra/*": ["./infra/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["apps", "test", "alchemy.run.ts", "vite.config.ts", "infra", "tools"]
}
